<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Quotation</title>

    <link rel="stylesheet" href="/stylesheets/style.css">

    <style>
        body{
            font-family: Arial, sans-serif;
            background:#f4f4f4;
            margin:0;
        }

        .container{
            width:95%;
            max-width:1200px;
            margin:30px auto;
            background:white;
            padding:25px;
            border-radius:10px;
            box-shadow:0 0 10px rgba(0,0,0,.1);
        }

        h2{
            margin-bottom:25px;
        }

        .row{
            display:flex;
            gap:20px;
            margin-bottom:20px;
        }

        .col{
            flex:1;
        }

        label{
            display:block;
            margin-bottom:6px;
            font-weight:bold;
        }

        input, textarea{
            width:100%;
            padding:10px;
            border:1px solid #ccc;
            border-radius:5px;
            box-sizing:border-box;
        }

        table{
            width:100%;
            border-collapse:collapse;
            margin-top:20px;
        }

        table th{
            background:#222;
            color:white;
            padding:10px;
        }

        table td{
            border:1px solid #ddd;
            padding:8px;
            text-align:center;
        }

        .btn{
            background:#007bff;
            color:white;
            border:none;
            padding:10px 18px;
            border-radius:5px;
            cursor:pointer;
        }

        .btn:hover{
            background:#0056b3;
        }

        .totalBox{
            width:350px;
            margin-left:auto;
            margin-top:30px;
        }

        .totalBox table td{
            text-align:right;
        }

    </style>

</head>
<body>

<div class="container">

<h2>Create New Quotation</h2>

<div class="row">

<div class="col">
<label>Quotation Number</label>

<input
type="text"
name="quotationNo"
value="<%= quotationNo %>"
readonly>
</div>

<div class="col">
    <label>Date</label>
    <input
        type="date"
        name="quotationDate"
        value="<%= today %>">
</div>

<div class="col">
    <label>Valid Till</label>
    <input
        type="date"
        name="validTill"
        value="<%= validTill %>">
</div>

</div>


<hr><br>

<h3>Client Details</h3>

 <div class="flex flex-wrap p-6 rounded-md">
              <div class="w-full md:w-1/4 px-3 mb-6 md:mb-0 relative">
                <label class="block text-gray-700 text-sm font-bold mb-2" for="inputusername">Name</label>
                <div>
                    <input id="inputusername" name="Name" placeholder="Name" class="form-input w-full py-2 px-3 border border-gray-800 rounded-md focus:outline-none focus:border-blue-500" type="text">

                  <div id="autocompleteDropdown" class="autocomplete-dropdownn"></div>
                </div>
              </div>
            
              <div class="w-full md:w-1/4 px-3">
                <label class="block text-gray-700 text-sm font-bold mb-2" for="inputAddress">Address</label>
                <input id="inputAddress" name="Address" placeholder="Address" class="form-input w-full py-2 px-3 border border-gray-800 rounded-md focus:outline-none focus:border-blue-500" type="text">

              </div>
            
              <div class="w-full md:w-1/4 px-3">
                <label class="block text-gray-700 text-sm font-bold mb-2" for="inputPhone">Phone</label>
                <input id="inputPhone" name="Phone" placeholder="Phone" class="form-input w-full py-2 px-3 border border-gray-800 rounded-md focus:outline-none focus:border-blue-500" type="text">
                <p id="phoneError" class="text-red-500 text-xs mt-1" style="display: none;">Phone number must be exactly 10 digits.</p>
              </div>
<script>
  document.addEventListener('DOMContentLoaded', function() {
  const phoneInput = document.getElementById('inputPhone');
  const phoneError = document.getElementById('phoneError');

  phoneInput.addEventListener('input', function() {
    const phoneValue = phoneInput.value;

    // Check if phone number is exactly 10 digits
    if (phoneValue.length !== 10 || isNaN(phoneValue)) {
      phoneError.style.display = 'block';
    } else {
      phoneError.style.display = 'none';
    }
  });
});

</script>              
            
              <div class="w-full md:w-1/4 px-3">
                <label class="block text-gray-700 text-sm font-bold mb-2" for="inputcomment">Comment</label>
                <input id="inputcomment" name="comment" placeholder="Comment" class="form-input w-full py-2 px-3 border border-gray-800 rounded-md focus:outline-none focus:border-blue-500" type="text">

              </div>
            </div>

<hr>

<h3>Items</h3>

<button class="btn">
+ Add Item
</button>

<table>

<thead>

<tr>

<th>Item</th>

<th>Qty</th>

<th>Rate</th>

<th>GST %</th>

<th>Total</th>

<th>Action</th>

</tr>

</thead>

<tbody id="itemTable">

</tbody>

</table>


<div class="totalBox">

<table>

<tr>

<td><b>Subtotal</b></td>

<td id="subtotal">0</td>

</tr>

<tr>

<td><b>Discount</b></td>

<td>0</td>

</tr>

<tr>

<td><b>GST</b></td>

<td>0</td>

</tr>

<tr>

<td><b>Grand Total</b></td>

<td id="grandtotal"><b>0</b></td>

</tr>

</table>

</div>

<br>

<h3>Terms & Conditions</h3>

<textarea rows="5"></textarea>

<br><br>

<button class="btn">
Save Quotation
</button>

<button class="btn">
Generate PDF
</button>

</div>

</body>
</html>
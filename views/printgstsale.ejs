      }
  </style>


    <style>
      .flex {
          display: flex;
          
          align-items: center;
          
      }
      .checc {
         margin-top:20px;
           margin-left: 220px;
          
      }
      .sign {
           margin-top: 50px;
          
      }
  .Advance{
      margin-top: 10px;
      font-size: 21px;
      
   
  }
     
  </style>

</body>
</html>

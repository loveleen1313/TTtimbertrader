<%- include('nav bar/navbar.ejs') %>

<!-- Price Edit Modal -->
<div id="priceModal" class="price-modal">
    <div class="price-modal-content">

        <h2>Edit Price</h2>

        <input type="number" id="newPrice" placeholder="Enter new price">

        <div class="btn-group">
            <button id="savePrice">Save</button>
            <button id="cancelPrice">Cancel</button>
        </div>

    </div>
</div>
<style>
    .price-modal{
display:none;
position:fixed;
left:0;
top:0;
width:100%;
height:100%;
background:rgba(0,0,0,.45);
justify-content:center;
align-items:center;
z-index:9999;
}

.price-modal-content{
background:#fff;
padding:25px;
border-radius:10px;
width:320px;
text-align:center;
box-shadow:0 10px 30px rgba(0,0,0,.2);
}

.price-modal input{
width:100%;
padding:10px;
font-size:18px;
margin-top:15px;
margin-bottom:20px;
}

.btn-group{
display:flex;
justify-content:space-between;
}

.btn-group button{
padding:10px 20px;
cursor:pointer;
border:none;
border-radius:6px;
font-size:15px;
}

#savePrice{
background:#007bff;
color:white;
}

#cancelPrice{
background:#dc3545;
color:white;
}

.editable-price{
cursor:pointer;
font-weight:bold;
color:#007bff;
}

.editable-price:hover{
text-decoration:underline;
}
</style>



    <title>ITEM Database</title>
    <link rel='stylesheet' href='/stylesheets/productallstyle.css' />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
</head>


    <main class="table">
        <section class="table__header">
            <div class="custom-container">
                <h1 class="custom-heading">Product Database</h1>
                <a href="/ttproduct" class="custom-link"><i class="fa-solid fa-file-circle-plus"></i></a>
            </div>
            <div class="input-group">
                <input type="search" placeholder="Search Data...">
                <img src="images/search.png" alt="">
            </div>
            
        </section>
        <section class="table__body">
            <table>
                <thead>
                    <tr>
                        <th data-sort-type="numeric"> #<span class="icon-arrow">&UpArrow;</span> </th>
                        <th data-sort-type="string"> Product Name <span class="icon-arrow">&UpArrow;</span></th>
                        <th data-sort-type="numeric"> Rent Price <span class="icon-arrow">&UpArrow;</span></th>
                        <th data-sort-type="numeric"> Selling Price <span class="icon-arrow">&UpArrow;</span></th>
                        <th data-sort-type="numeric"> Stock <span class="icon-arrow">&UpArrow;</span></th>
                        <th data-sort-type="string"> Category <span class="icon-arrow">&UpArrow;</span></th>
                        <th data-sort-type="string"> Action <span class="icon-arrow">&UpArrow;</span></th>
                    </tr>
                </thead>
                <tbody>
                    <% let serialNumber = 1; %>
                    <% allproducts.forEach(function(post) { %>
                        <tr>
                            <td><%= serialNumber++ %></td>
                            <td><%= post.itemName %></td>
                            <td>
    <span class="editable-price"
          data-id="<%= post._id %>"
          data-field="rentPrice"
          data-value="<%= post.rentPrice %>">
        ₹<%= post.rentPrice %>
    </span>
</td>

<td>
    <span class="editable-price"
          data-id="<%= post._id %>"
          data-field="sellingPrice"
          data-value="<%= post.sellingPrice %>">
        ₹<%= post.sellingPrice %>
    </span>
</td>
                            <td><%= post.workingQuantity %></td>
                            
                            <% if (post.itemCategory == 1) { %>
                                <td>machine</td>
                            <% } else if (post.itemCategory == 2) { %>
                                <td>Scaffolding</td>
                                <% } else if (post.itemCategory == 3) { %>
                                    <td>Farma 5ft</td>
                                    <% } else if (post.itemCategory == 4) { %>
                                        <td>Farma 6ft</td>
                                        <% } else if (post.itemCategory == 5) { %>
                                            <td>Farma 9ft</td>
                                            <% } else if (post.itemCategory == 6) { %>
                                                <td>Farma 10ft</td>
                            <% } else { %>
                                <td><%= post.itemCategory %></td>
                            <% } %>
                            
                        
                            <td>
                                <a href="/edit/<%= post._id %>"><i class="fa-solid fa-pen-to-square"></i></a>
                                <a href="#" onclick="confirmDelete('<%= post._id %>')" class="delete-link"><i class="fa-solid fa-trash-can"></i></a>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </section>
        <script>

let currentId="";
let currentField="";
let currentElement=null;

const modal=document.getElementById("priceModal");
const input=document.getElementById("newPrice");

document.querySelectorAll(".editable-price").forEach(e=>{

e.onclick=function(){

currentId=this.dataset.id;
currentField=this.dataset.field;
currentElement=this;

input.value=this.dataset.value;

modal.style.display="flex";

}

});

document.getElementById("cancelPrice").onclick=function(){

modal.style.display="none";

}

document.getElementById("savePrice").onclick=async function(){

const value=input.value;

const res=await fetch("/updateprice",{

method:"POST",

headers:{
"Content-Type":"application/json"
},

body:JSON.stringify({

id:currentId,

field:currentField,

value:value

})

});

const data=await res.json();

if(data.success){

currentElement.innerHTML="₹"+value;

currentElement.dataset.value=value;

modal.style.display="none";

}else{

alert("Unable to update.");

}

}

window.onclick=function(e){

if(e.target==modal){

modal.style.display="none";

}

}

</script>
    </main>
    <script src="./javascripts/productall.js"></script>
    <%- include('nav bar/navbardown.ejs') %>

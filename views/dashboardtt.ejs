    );


    // ------------------------------------------
    // Quantity listener
    // ------------------------------------------

    const newQuantityInput =
        newRow.querySelector(
            'input[name="quantity[]"]'
        );


    newQuantityInput.addEventListener(
        "input",
        function () {

            updateBuyAmount(newRow);

        }
    );


    // ------------------------------------------
    // Purchase Rate listener
    // ------------------------------------------

    const newPurchaseRateInput =
        newRow.querySelector(
            'input[name="purchaseRate[]"]'
        );


    newPurchaseRateInput.addEventListener(
        "input",
        function () {

            updateBuyAmount(newRow);

        }
    );

}


// ======================================================
// DELETE PURCHASE ROW
// ======================================================

function deleteBuyRow(button) {

    const buyRows =
        document.getElementById("buy-rows");


    const rows =
        buyRows.querySelectorAll(".buy-row");


    const row =
        button.closest(".buy-row");


    // Don't allow deleting the last row
    if (rows.length === 1) {

        alert("At least one material is required.");

        return;
    }


    // Remove row
    row.remove();


    // ------------------------------------------
    // Renumber rows
    // ------------------------------------------

    const remainingRows =
        buyRows.querySelectorAll(".buy-row");


    remainingRows.forEach(
        (row, index) => {

            row.querySelector(
                ".serial-number"
            ).textContent =
                index + 1;

        }
    );


    buyRowCounter =
        remainingRows.length;


    // Update total
    updateBuyGrandTotal();

}


// ======================================================
// CALCULATE INDIVIDUAL ROW AMOUNT
// ======================================================

function updateBuyAmount(row) {

    if (!row) return;


    const quantity =
        parseFloat(
            row.querySelector(
                'input[name="quantity[]"]'
            ).value
        ) || 0;


    const purchaseRate =
        parseFloat(
            row.querySelector(
                'input[name="purchaseRate[]"]'
            ).value
        ) || 0;


    const amountInput =
        row.querySelector(
            'input[name="amount[]"]'
        );


    // Quantity × Buying Price
    amountInput.value =
        (quantity * purchaseRate).toFixed(2);


    // Update grand total
    updateBuyGrandTotal();

}


// ======================================================
// UPDATE GRAND TOTAL
// ======================================================
function updateBuyGrandTotal() {

    // ======================================================
    // MATERIAL TOTAL
    // ======================================================

    let materialTotal = 0;

    document.querySelectorAll(
        '#buyEntry input[name="amount[]"]'
    ).forEach(input => {

        materialTotal +=
            parseFloat(input.value) || 0;

    });


    // ======================================================
    // ADDITIONAL CHARGES TOTAL
    // ======================================================

    let additionalTotal = 0;

    document.querySelectorAll(
        '#buyEntry input[name="chargeAmount[]"]'
    ).forEach(input => {

        additionalTotal +=
            parseFloat(input.value) || 0;

    });


    // ======================================================
    // GRAND TOTAL
    // ======================================================

    const grandTotal =
        materialTotal + additionalTotal;


    // ======================================================
    // SHOW ADDITIONAL CHARGES TOTAL
    // ======================================================

    const additionalElement =
        document.getElementById(
            "buy-additional-total"
        );

    if (additionalElement) {

        additionalElement.innerText =
            `Rs ${additionalTotal.toFixed(2)}`;

    }


    // ======================================================
    // SHOW GRAND TOTAL
    // ======================================================

    const totalElement =
        document.getElementById(
            "buy-grand-total"
        );

    if (totalElement) {

        totalElement.innerText =
            `Rs ${grandTotal.toFixed(2)}`;

    }


    // Update payment section

    updateBuyPaymentSummary();

}

document.addEventListener(
    "click",
    function (event) {

        const autocompleteInputs =
            document.querySelectorAll(
                '#buyEntry input[name="item[]"]'
            );


        const autocompleteDropdowns =

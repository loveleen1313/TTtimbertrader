<script>

// ======================================================
// PAYMENT ROW COUNTER
// ======================================================

let buyPaymentRowCounter = 1;


// ======================================================
// GET CURRENT DATE/TIME FOR DATETIME-LOCAL
// ======================================================

function getCurrentDateTimeLocal() {

    const now = new Date();

    const year =
        now.getFullYear();

    const month =
        String(now.getMonth() + 1)
            .padStart(2, "0");

    const day =
        String(now.getDate())
            .padStart(2, "0");

    const hours =
        String(now.getHours())
            .padStart(2, "0");

    const minutes =
        String(now.getMinutes())
            .padStart(2, "0");


    return `${year}-${month}-${day}T${hours}:${minutes}`;
}


// ======================================================
// ADD PAYMENT ROW
// ======================================================

function addBuyPaymentRow() {

    const paymentRows =
        document.getElementById(
            "buy-payment-rows"
        );

    if (!paymentRows) return;


    buyPaymentRowCounter++;


    const newRow =
        document.createElement("tr");

    newRow.className =
        "buy-payment-row";


    newRow.innerHTML = `

        <td class="p-2 border text-center payment-number">

            ${buyPaymentRowCounter}

        </td>


        <td class="p-2 border">

            <select
                name="paymentMode[]"
                class="styled-select w-full">

                <option value="cash">
                    Cash
                </option>

                <option value="upi">
                    UPI / Paytm
                </option>

                <option value="bank">
                    Bank
                </option>

                <option value="cheque">
                    Cheque
                </option>

                <option value="other">
                    Other
                </option>

            </select>

        </td>


        <td class="p-2 border">

            <input
                type="number"
                name="paymentAmount[]"
                class="input-field w-full payment-amount"
                placeholder="Amount"
                min="0"
                step="0.01"
                oninput="updateBuyPaymentSummary()">

        </td>


        <td class="p-2 border">

            <input
                type="datetime-local"
                name="paymentDate[]"
                class="input-field w-full payment-date"
                value="${getCurrentDateTimeLocal()}">

        </td>


        <td class="p-2 border text-center">

            <button
                type="button"
                onclick="deleteBuyPaymentRow(this)"
                class="delete-button">

                <i class="fa-solid fa-trash-can"></i>

            </button>

        </td>

    `;


    paymentRows.appendChild(newRow);

    updateBuyPaymentSummary();
}


// ======================================================
// DELETE PAYMENT ROW
// ======================================================

function deleteBuyPaymentRow(button) {

    const paymentRows =
        document.getElementById(
            "buy-payment-rows"
        );


    const rows =
        paymentRows.querySelectorAll(
            ".buy-payment-row"
        );


    if (rows.length === 1) {

        const amount =
            rows[0].querySelector(
                ".payment-amount"
            );

        if (amount) {
            amount.value = "";
        }


        updateBuyPaymentSummary();

        return;
    }


    const row =
        button.closest(
            ".buy-payment-row"
        );


    if (row) {
        row.remove();
    }


    // Renumber

    const remainingRows =
        paymentRows.querySelectorAll(
            ".buy-payment-row"
        );


    remainingRows.forEach(
        (row, index) => {

            const number =
                row.querySelector(
                    ".payment-number"
                );

            if (number) {
                number.textContent =
                    index + 1;
            }

        }
    );


    buyPaymentRowCounter =
        remainingRows.length;


    updateBuyPaymentSummary();
}


// ======================================================
// PAYMENT SUMMARY
// ======================================================

function updateBuyPaymentSummary() {

    // ----------------------------------------------
    // MATERIAL TOTAL
    // ----------------------------------------------

    let materialTotal = 0;


    document.querySelectorAll(
        '#buyEntry input[name="amount[]"]'
    ).forEach(input => {

        materialTotal +=
            parseFloat(input.value) || 0;

    });


    // ----------------------------------------------
    // ADDITIONAL CHARGES
    // ----------------------------------------------

    let additionalTotal = 0;


    document.querySelectorAll(
        '#buyEntry input[name="chargeAmount[]"]'
    ).forEach(input => {

        additionalTotal +=
            parseFloat(input.value) || 0;

    });


    // ----------------------------------------------
    // GRAND TOTAL
    // ----------------------------------------------

    const grandTotal =
        materialTotal +
        additionalTotal;


    // ----------------------------------------------
    // PAID
    // ----------------------------------------------

    let paidTotal = 0;


    document.querySelectorAll(
        '#buyEntry input[name="paymentAmount[]"]'
    ).forEach(input => {

        paidTotal +=
            parseFloat(input.value) || 0;

    });


    // ----------------------------------------------
    // PENDING
    // ----------------------------------------------

    let pendingTotal =
        grandTotal - paidTotal;


    if (pendingTotal < 0) {
        pendingTotal = 0;
    }


    // ----------------------------------------------
    // DISPLAY
    // ----------------------------------------------

    const purchaseTotal =
        document.getElementById(
            "payment-purchase-total"
        );

    if (purchaseTotal) {

        purchaseTotal.innerText =
            `Rs ${grandTotal.toFixed(2)}`;

    }


    const paidElement =
        document.getElementById(
            "payment-paid-total"
        );

    if (paidElement) {

        paidElement.innerText =
            `Rs ${paidTotal.toFixed(2)}`;

    }


    const pendingElement =
        document.getElementById(
            "payment-pending-total"
        );

    if (pendingElement) {

        pendingElement.innerText =
            `Rs ${pendingTotal.toFixed(2)}`;

    }

}


// ======================================================
// INITIALIZE FIRST PAYMENT DATE
// ======================================================

document.addEventListener(
    "DOMContentLoaded",
    function() {

        const firstDate =
            document.querySelector(
                '#buy-payment-rows .payment-date'
            );


        if (
            firstDate &&
            !firstDate.value
        ) {

            firstDate.value =
                getCurrentDateTimeLocal();

        }

    }
);

</script>


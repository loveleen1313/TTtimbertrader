        } else if (item.modeofpayment === 'cash') {
            if (item.inandout == 1) totalCashIn += Number(item.amount) || 0;
            else if (item.inandout == 0) totalCashOut += Number(item.amount) || 0;
        } else if (item.modeofpayment === 'paytm') {
            if (item.inandout == 1) totalPaytmIn += Number(item.amount) || 0;
            else if (item.inandout == 0) totalPaytmOut += Number(item.amount) || 0;
        }
    });

    // Existing pie chart net totals
    totalCashIn = totalCashIn - totalCashOut;
    totalPaytmIn = totalPaytmIn - totalPaytmOut;

    // Calculate net balance by transaction type
    const transactionTypeTotals = {};

    receiptEdit.forEach(item => {
        const type = item.transactionType || 'Other';
        const amount = Number(item.amount) || 0;

        if (!transactionTypeTotals[type]) {
            transactionTypeTotals[type] = 0;
        }

        if (item.inandout == 1) {
            transactionTypeTotals[type] += amount;
        } else if (item.inandout == 0) {
            transactionTypeTotals[type] -= amount;
        }
    });

    const transactionLabels = Object.keys(transactionTypeTotals);
    const transactionBalances = Object.values(transactionTypeTotals);

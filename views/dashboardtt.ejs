                          <style>
                            .modal { display: none; position: fixed; z-index: 1; left: 0; top: 0; width: 100%; height: 100%; overflow: auto; background-color: rgba(0,0,0,0.4); }
                            .modal-content { background-color: #fff; margin: 15% auto; padding: 20px; border: 1px solid #888; width: 80%; }
                            .close { color: #aaa; float: right; font-size: 28px; font-weight: bold; cursor: pointer; }
                            .close:hover { color: black; }
                            #editForm { display: flex; flex-direction: column; }
                            #editForm input, select { padding: 8px; margin-bottom: 10px; border: 1px solid #ccc; border-radius: 4px; }
                            #editForm button { padding: 10px; background-color: #4CAF50; color: white; border: none; border-radius: 4px; cursor: pointer; }
                            .total-link { font-weight: bold; text-decoration: none; color: blue; }
                            .total-link:hover { text-decoration: underline; }
                          </style>
                          
                          <script>
  var modal = document.getElementById("editModal");
  var span = document.getElementsByClassName("close")[0];

  span.onclick = function () {
    modal.style.display = "none";
  };

  window.onclick = function (event) {
    if (event.target == modal) {
      modal.style.display = "none";
    }
  };

  // Open edit modal with the current transaction details
  function openEditModal(id, amount, comment, modeOfPayment, transactionType) {
  document.getElementById("editId").value = id;
  document.getElementById("editAmount").value = amount;
  document.getElementById("editComment").value = comment || "";
  document.getElementById("editModeOfPayment").value = modeOfPayment || "cash";

  var typeSelect = document.getElementById("editTransactionType");

  var types = [
    "Rent",
    "Business Sale",
    "Staff & Labour Payments",
    "Material Buy",
    "Other"
  ];

  // Handle older transactions saved with the previous category name
  if (transactionType === "Business Labour") {
    transactionType = "Staff & Labour Payments";
  }

  // Show the current transaction type first
  typeSelect.innerHTML = "";

  if (types.includes(transactionType)) {
    typeSelect.add(new Option(transactionType, transactionType));
  } else {
    typeSelect.add(new Option("Select transaction type", ""));
  }

  // Add the remaining categories below it
  types.forEach(function (type) {
    if (type !== transactionType) {
      typeSelect.add(new Option(type, type));
    }
  });

  typeSelect.value = types.includes(transactionType)
    ? transactionType
    : "";

  modal.style.display = "block";
}
  // Save edited transaction
  function submitEditForm() {
    var id = document.getElementById("editId").value;
    var amount = document.getElementById("editAmount").value;
    var comment = document.getElementById("editComment").value;
    var modeofpayment = document.getElementById("editModeOfPayment").value;
    var transactionType = document.getElementById("editTransactionType").value;

    fetch("/editmoney/" + id, {
      method: "POST",
      headers: {
        "Content-Type": "application/json"
      },
      body: JSON.stringify({
        amount: amount,
        comment: comment,
        modeofpayment: modeofpayment,
        transactionType: transactionType
      })
    })
    .then(function (response) {
      if (!response.ok) {
        throw new Error("Failed to update transaction");
      }
      return response.json();
    })
    .then(function (response) {
      var row = document.getElementById("row-" + id);

      if (row) {
        var amountCell = row.querySelector(".amount");
        var commentCell = row.querySelector(".comment");
        var typeCell = row.querySelector(".transactionType");

        if (amountCell) {
          amountCell.innerText = response.amount;
        }

        if (commentCell) {
          commentCell.innerText =
            (response.comment || "") +
            (response.modeofpayment === "paytm" ? " (Paytm)" : "");
        }

        if (typeCell) {
          typeCell.innerText = response.transactionType || "";
        }
      }

      modal.style.display = "none";
    })
    .catch(function (error) {
      alert("Error: " + error.message);
    });
  }
</script>

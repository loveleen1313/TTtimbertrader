<script>

// ======================================================
// ADDITIONAL CHARGES
// ======================================================

let buyChargeRowCounter = 1;


// ======================================================
// ADD NEW CHARGE ROW
// ======================================================

function addBuyChargeRow() {

    const chargeRows =
        document.getElementById("buy-charge-rows");

    if (!chargeRows) return;


    const newRow =
        document.createElement("tr");

    newRow.className =
        "buy-charge-row";


    buyChargeRowCounter++;


    newRow.innerHTML = `

        <td class="p-2 border text-center charge-number">
            ${buyChargeRowCounter}
        </td>


        <td class="p-2 border">

            <input
                type="text"
                name="chargeDescription[]"
                class="input-field w-full"
                placeholder="Transport / Loading / Labour">

        </td>


        <td class="p-2 border">

            <input
                type="number"
                name="chargeAmount[]"
                class="input-field w-full charge-amount"
                placeholder="Amount"
                min="0"
                step="0.01"
                oninput="updateBuyGrandTotal()">

        </td>


        <td class="p-2 border text-center">

            <button
                type="button"
                onclick="deleteBuyChargeRow(this)"
                class="delete-button">

                <i class="fa-solid fa-trash-can"></i>

            </button>

        </td>

    `;


    chargeRows.appendChild(newRow);


    // Recalculate everything

    updateBuyGrandTotal();
}


// ======================================================
// DELETE CHARGE ROW
// ======================================================

function deleteBuyChargeRow(button) {

    const chargeRows =
        document.getElementById("buy-charge-rows");

    if (!chargeRows) return;


    const rows =
        chargeRows.querySelectorAll(".buy-charge-row");


    // If only one row exists,
    // just clear it instead of deleting it.

    if (rows.length === 1) {

        const descriptionInput =
            rows[0].querySelector(
                'input[name="chargeDescription[]"]'
            );

        const amountInput =
            rows[0].querySelector(
                'input[name="chargeAmount[]"]'
            );


        if (descriptionInput) {
            descriptionInput.value = "";
        }


        if (amountInput) {
            amountInput.value = "";
        }


        updateBuyGrandTotal();

        return;
    }


    // Delete selected row

    const row =
        button.closest(".buy-charge-row");

    if (row) {
        row.remove();
    }


    // ======================================================
    // RENUMBER CHARGES
    // ======================================================

    const remainingRows =
        chargeRows.querySelectorAll(".buy-charge-row");


    remainingRows.forEach((row, index) => {

        const numberCell =
            row.querySelector(".charge-number");

        if (numberCell) {

            numberCell.textContent =
                index + 1;

        }

    });


    buyChargeRowCounter =
        remainingRows.length;


    // Recalculate

    updateBuyGrandTotal();
}


// ======================================================
// CALCULATE ADDITIONAL CHARGES TOTAL
// ======================================================

function getBuyAdditionalChargesTotal() {

    let additionalTotal = 0;


    document.querySelectorAll(
        '#buyEntry input[name="chargeAmount[]"]'
    ).forEach(input => {

        additionalTotal +=
            parseFloat(input.value) || 0;

    });


    return additionalTotal;
}


// ======================================================
// CALCULATE MATERIAL TOTAL
// ======================================================

function getBuyMaterialTotal() {

    let materialTotal = 0;


    document.querySelectorAll(
        '#buyEntry input[name="amount[]"]'
    ).forEach(input => {

        materialTotal +=
            parseFloat(input.value) || 0;

    });


    return materialTotal;
}


// ======================================================
// UPDATE GRAND TOTAL
// ======================================================

function updateBuyGrandTotal() {

    // Material total

    const materialTotal =
        getBuyMaterialTotal();


    // Additional charges total

    const additionalTotal =
        getBuyAdditionalChargesTotal();


    // Grand total

    const grandTotal =
        materialTotal + additionalTotal;


    // ======================================================
    // SHOW ADDITIONAL CHARGES TOTAL
    // ======================================================

    const additionalTotalElement =
        document.getElementById(
            "buy-additional-total"
        );


    if (additionalTotalElement) {

        additionalTotalElement.innerText =
            `Rs ${additionalTotal.toFixed(2)}`;

    }


    // ======================================================
    // SHOW GRAND TOTAL
    // ======================================================

    const grandTotalElement =
        document.getElementById(
            "buy-grand-total"
        );


    if (grandTotalElement) {

        grandTotalElement.innerText =
            `Rs ${grandTotal.toFixed(2)}`;

    }


    // ======================================================
    // UPDATE PAYMENT SUMMARY
    // ======================================================

    if (
        typeof updateBuyPaymentSummary ===
        "function"
    ) {

        updateBuyPaymentSummary();

    }

}

</script>
 

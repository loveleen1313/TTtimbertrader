                );

            }

        }
    );

});


// ======================================================
// UP / DOWN NAVIGATION
// ======================================================

function navigateBuyUpDown(
    element,
    direction
) {

    const targetElement =
        $(element)[direction]();


    if (targetElement.length > 0) {

        targetElement.focus();


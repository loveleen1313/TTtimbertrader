<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Task Board | TT Timber Trader</title>

    <link rel="stylesheet" href="/stylesheets/receipt.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer">

    <style>
        :root {
            --page-bg: #f3f6fb;
            --surface: #ffffff;
            --text: #172033;
            --muted: #687386;
            --border: #e3e8f0;
            --blue: #2563eb;
            --blue-dark: #1d4ed8;
            --todo: #64748b;
            --waiting: #d97706;
            --complete: #059669;
            --shadow: 0 8px 26px rgba(15, 23, 42, 0.06);
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            min-width: 320px;
            background: #f4f6fb !important;
            color: var(--text);
            font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        }

        /*
          The shared navbar has a fixed top bar and a left sidebar.
          Give the board its own space so the heading never sits underneath the navbar.
        */
        main.todo-page {
            display: block;
            position: relative;
            z-index: 1;
            width: auto !important;
            max-width: none !important;
            min-height: calc(100vh - 150px);
            margin: 0 28px 0 108px !important;
            padding: 104px 0 48px !important;
            background: transparent;
        }

        .todo-topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 22px;
            flex-wrap: wrap;
            margin: 0 0 22px;
        }

        .todo-title-wrap { min-width: 220px; }
        .todo-eyebrow {
            margin: 0 0 6px;
            color: var(--blue);
            font-size: 12px;
            font-weight: 800;
            letter-spacing: .12em;
            text-transform: uppercase;
        }
        .todo-title {
            margin: 0;
            font-size: clamp(26px, 3vw, 36px);
            line-height: 1.15;
            font-weight: 800;
            letter-spacing: -.04em;
        }
        .todo-subtitle {
            margin: 9px 0 0;
            color: var(--muted);
            font-size: 14px;
        }

        .todo-toolbar {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }
        .todo-search {
            display: flex;
            align-items: center;
            gap: 10px;
            width: min(320px, 78vw);
            min-height: 44px;
            padding: 0 14px;
            border: 1px solid var(--border);
            border-radius: 12px;
            background: var(--surface);
            box-shadow: 0 2px 8px rgba(15, 23, 42, .02);
        }
        .todo-search i { color: #8a94a6; }
        .todo-search input {
            width: 100%;
            border: 0;
            outline: 0;
            background: transparent;
            color: var(--text);
            font: inherit;
            font-size: 14px;
        }
        .todo-search input::placeholder { color: #9aa3b2; }

        .add-task-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 9px;
            min-height: 44px;
            padding: 0 17px;
            border-radius: 12px;
            background: var(--blue);
            color: #fff !important;
            text-decoration: none !important;
            font-size: 14px;
            font-weight: 750;
            box-shadow: 0 5px 12px rgba(37, 99, 235, .2);
            transition: background .18s ease, transform .18s ease;
            white-space: nowrap;
        }
        .add-task-btn:hover { background: var(--blue-dark); transform: translateY(-1px); }

        .todo-summary {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 14px;
            margin-bottom: 20px;
        }
        .summary-card {
            display: flex;
            align-items: center;
            gap: 14px;
            min-width: 0;
            padding: 17px 18px;
            border: 1px solid var(--border);
            border-radius: 16px;
            background: var(--surface);
            box-shadow: var(--shadow);
        }
        .summary-icon {
            display: grid;
            place-items: center;
            width: 44px;
            height: 44px;
            flex: 0 0 44px;
            border-radius: 13px;
            font-size: 17px;
        }
        .summary-icon.todo { color: var(--todo); background: #eef2f7; }
        .summary-icon.waiting { color: var(--waiting); background: #fff4df; }
        .summary-icon.complete { color: var(--complete); background: #dcfce9; }
        .summary-label { color: var(--muted); font-size: 12px; font-weight: 700; }
        .summary-number { margin-top: 2px; font-size: 25px; font-weight: 800; line-height: 1.1; }

        .task-board {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            align-items: start;
            gap: 16px;
        }
        .task-column {
            min-width: 0;
            overflow: hidden;
            border: 1px solid #e1e7f0;
            border-radius: 15px;
            background: #eef2f8;
            box-shadow: 0 5px 18px rgba(15, 23, 42, .035);
        }
        .column-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            padding: 14px 16px;
            border-bottom: 1px solid #e1e7f0;
            background: #fff;
        }
        .column-heading {
            display: flex;
            align-items: center;
            gap: 10px;
            margin: 0;
            font-size: 14px;
            font-weight: 850;
            letter-spacing: .04em;
        }
        .status-dot { width: 9px; height: 9px; border-radius: 50%; display: inline-block; }
        .status-dot.todo { background: var(--todo); }
        .status-dot.waiting { background: var(--waiting); }
        .status-dot.complete { background: var(--complete); }
        .column-count {
            display: inline-grid;
            place-items: center;
            min-width: 28px;
            height: 26px;
            padding: 0 8px;
            border-radius: 8px;
            background: #eef2f7;
            color: #465166;
            font-size: 12px;
            font-weight: 800;
        }
        .task-list {
            display: flex;
            flex-direction: column;
            gap: 10px;
            min-height: 112px;
            padding: 11px;
        }
        .task-card {
            padding: 13px 14px;
            border: 1px solid #e7ebf2;
            border-radius: 13px;
            background: var(--surface);
            box-shadow: 0 3px 10px rgba(15, 23, 42, .035);
            transition: transform .16s ease, box-shadow .16s ease;
        }
        .task-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 18px rgba(15, 23, 42, .08);
        }
        .task-name {
            margin: 0;
            color: #202b3f;
            font-size: 14px;
            line-height: 1.55;
            font-weight: 650;
            overflow-wrap: anywhere;
            white-space: pre-wrap;
        }
        .task-card-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            margin-top: 15px;
            padding-top: 12px;
            border-top: 1px solid #eef1f5;
        }
        .task-status-label {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            color: var(--muted);
            font-size: 11px;
            font-weight: 750;
        }
        .task-actions { display: flex; align-items: center; gap: 7px; }
        .task-action {
            display: inline-grid;
            place-items: center;
            width: 33px;
            height: 33px;
            border: 1px solid var(--border);
            border-radius: 9px;
            background: #fff;
            color: #657084 !important;
            text-decoration: none !important;
            font-size: 13px;
            transition: background .16s ease, color .16s ease, border-color .16s ease;
        }
        .task-action.edit:hover { color: var(--blue) !important; border-color: #bfdbfe; background: #eff6ff; }
        .task-action.delete:hover { color: #dc2626 !important; border-color: #fecaca; background: #fef2f2; }
        .move-task-form {
            display: inline-flex;
            margin: 0;
        }
        button.task-action.move {
            padding: 0;
            cursor: pointer;
            font-family: inherit;
            appearance: none;
            -webkit-appearance: none;
        }
        .task-action.move:hover {
            color: var(--blue) !important;
            border-color: #bfdbfe;
            background: #eff6ff;
        }
        .empty-column {
            padding: 26px 12px;
            color: #8b95a6;
            text-align: center;
            font-size: 13px;
        }
        .empty-column i { display: block; margin-bottom: 10px; font-size: 22px; color: #b1bac8; }
        .no-search-results {
            display: none;
            padding: 28px 16px;
            color: var(--muted);
            text-align: center;
            font-size: 14px;
        }
        .no-search-results i { display: block; margin-bottom: 9px; font-size: 24px; color: #a7b0bf; }

        @media (max-width: 1150px) {
            main.todo-page {
                margin-left: 100px !important;
                margin-right: 20px !important;
            }
            .task-board { grid-template-columns: repeat(2, minmax(0, 1fr)); }
            .task-column[data-column="complete"] { grid-column: 1 / -1; }
        }

        @media (max-width: 760px) {
            main.todo-page {
                margin: 0 14px 0 82px !important;
                padding-top: 92px !important;
            }
            .todo-topbar { align-items: stretch; }
            .todo-title-wrap { min-width: 0; }
            .todo-toolbar { width: 100%; }
            .todo-search { flex: 1 1 100%; width: 100%; }
            .add-task-btn { flex: 0 0 auto; }
            .task-board { grid-template-columns: 1fr; }
            .task-column[data-column="complete"] { grid-column: auto; }
            .task-list { min-height: 82px; }
        }

        @media (max-width: 480px) {
            main.todo-page {
                margin: 0 10px 0 72px !important;
                padding-top: 88px !important;
            }
            .todo-summary { grid-template-columns: 1fr; gap: 9px; }
            .summary-card { padding: 12px 14px; }
            .todo-title { font-size: 27px; }
            .add-task-btn { min-width: 100%; }
        }
    </style>
</head>
<body>
    <%- include('nav bar/navbar.ejs') %>

    <main class="todo-page">
        <% const tasks = Array.isArray(alltodo) ? alltodo.slice().reverse() : []; %>
        <% const todoTasks = tasks.filter(task => Number(task.work) === 1); %>
        <% const waitingTasks = tasks.filter(task => Number(task.work) === 2); %>
        <% const completeTasks = tasks.filter(task => Number(task.work) === 3); %>

        <header class="todo-topbar">
            <div class="todo-title-wrap">
                <p class="todo-eyebrow">TT Timber Trader · Work Planner</p>
                <h1 class="todo-title">Task Board</h1>
                <p class="todo-subtitle">Keep track of tasks, follow-ups, and completed work.</p>
            </div>

            <div class="todo-toolbar">
                <label class="todo-search" for="todoSearch">
                    <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                    <input id="todoSearch" type="search" placeholder="Search tasks..." autocomplete="off">
                </label>
                <a href="/addtodo" class="add-task-btn">
                    <i class="fa-solid fa-plus" aria-hidden="true"></i>
                    Add Task
                </a>
            </div>
        </header>

        <section class="todo-summary" aria-label="Task summary">
            <article class="summary-card">
                <div class="summary-icon todo"><i class="fa-solid fa-list-check" aria-hidden="true"></i></div>
                <div><div class="summary-label">TODO</div><div class="summary-number" id="todoSummaryCount"><%= todoTasks.length %></div></div>
            </article>
            <article class="summary-card">
                <div class="summary-icon waiting"><i class="fa-regular fa-clock" aria-hidden="true"></i></div>
                <div><div class="summary-label">WAITING</div><div class="summary-number" id="waitingSummaryCount"><%= waitingTasks.length %></div></div>
            </article>
            <article class="summary-card">
                <div class="summary-icon complete"><i class="fa-solid fa-check-double" aria-hidden="true"></i></div>
                <div><div class="summary-label">COMPLETE</div><div class="summary-number" id="completeSummaryCount"><%= completeTasks.length %></div></div>
            </article>
        </section>

        <section class="task-board" id="taskBoard" aria-label="Tasks grouped by status">
            <!-- TODO COLUMN -->
            <section class="task-column" data-column="todo">
                <header class="column-header">
                    <h2 class="column-heading"><span class="status-dot todo"></span> TODO</h2>
                    <span class="column-count"><%= todoTasks.length %></span>
                </header>
                <div class="task-list">
                    <% if (todoTasks.length) { %>
                        <% todoTasks.forEach(task => { %>
                            <article class="task-card" data-task-name="<%= String(task.name || '').toLowerCase() %>">
                                <h3 class="task-name"><%= task.name || 'Untitled task' %></h3>
                                <div class="task-card-footer">
                                    <span class="task-status-label"><span class="status-dot todo"></span> To do</span>
                                    <div class="task-actions">
                                        <a class="task-action edit" href="/changetodoitem/<%= task._id %>" title="Edit task" aria-label="Edit task"><i class="fa-solid fa-pen-to-square"></i></a>
                                        <form class="move-task-form" method="POST" action="/movetodo/<%= task._id %>">
                                            <button type="submit" class="task-action move" title="Move to Waiting" aria-label="Move task to Waiting">
                                                <i class="fa-solid fa-arrow-right"></i>
                                            </button>
                                        </form>
                                        <a class="task-action delete" href="/deletetodoitem/<%= task._id %>" title="Delete task" aria-label="Delete task" onclick="return confirm('Are you sure you want to delete this task?');"><i class="fa-solid fa-trash-can"></i></a>
                                    </div>
                                </div>
                            </article>
                        <% }); %>
                    <% } else { %>
                        <div class="empty-column"><i class="fa-regular fa-clipboard"></i>No tasks to do yet.</div>
                    <% } %>
                </div>
            </section>

            <!-- WAITING COLUMN -->
            <section class="task-column" data-column="waiting">
                <header class="column-header">
                    <h2 class="column-heading"><span class="status-dot waiting"></span> WAITING</h2>
                    <span class="column-count"><%= waitingTasks.length %></span>
                </header>
                <div class="task-list">
                    <% if (waitingTasks.length) { %>
                        <% waitingTasks.forEach(task => { %>
                            <article class="task-card" data-task-name="<%= String(task.name || '').toLowerCase() %>">
                                <h3 class="task-name"><%= task.name || 'Untitled task' %></h3>
                                <div class="task-card-footer">
                                    <span class="task-status-label"><span class="status-dot waiting"></span> Waiting</span>
                                    <div class="task-actions">
                                        <a class="task-action edit" href="/changetodoitem/<%= task._id %>" title="Edit task" aria-label="Edit task"><i class="fa-solid fa-pen-to-square"></i></a>
                                        <form class="move-task-form" method="POST" action="/movetodo/<%= task._id %>">
                                            <button type="submit" class="task-action move" title="Move to Complete" aria-label="Move task to Complete">
                                                <i class="fa-solid fa-arrow-right"></i>
                                            </button>
                                        </form>
                                        <a class="task-action delete" href="/deletetodoitem/<%= task._id %>" title="Delete task" aria-label="Delete task" onclick="return confirm('Are you sure you want to delete this task?');"><i class="fa-solid fa-trash-can"></i></a>
                                    </div>
                                </div>
                            </article>
                        <% }); %>
                    <% } else { %>
                        <div class="empty-column"><i class="fa-regular fa-hourglass-half"></i>Nothing waiting right now.</div>
                    <% } %>
                </div>
            </section>

            <!-- COMPLETE COLUMN -->
            <section class="task-column" data-column="complete">
                <header class="column-header">
                    <h2 class="column-heading"><span class="status-dot complete"></span> COMPLETE</h2>
                    <span class="column-count"><%= completeTasks.length %></span>
                </header>
                <div class="task-list">
                    <% if (completeTasks.length) { %>
                        <% completeTasks.forEach(task => { %>
                            <article class="task-card" data-task-name="<%= String(task.name || '').toLowerCase() %>">
                                <h3 class="task-name"><%= task.name || 'Untitled task' %></h3>
                                <div class="task-card-footer">
                                    <span class="task-status-label"><span class="status-dot complete"></span> Completed</span>
                                    <div class="task-actions">
                                        <a class="task-action edit" href="/changetodoitem/<%= task._id %>" title="Edit task" aria-label="Edit task"><i class="fa-solid fa-pen-to-square"></i></a>
                                        <a class="task-action delete" href="/deletetodoitem/<%= task._id %>" title="Delete task" aria-label="Delete task" onclick="return confirm('Are you sure you want to delete this task?');"><i class="fa-solid fa-trash-can"></i></a>
                                    </div>
                                </div>
                            </article>
                        <% }); %>
                    <% } else { %>
                        <div class="empty-column"><i class="fa-solid fa-circle-check"></i>No completed tasks yet.</div>
                    <% } %>
                </div>
            </section>
        </section>

        <div class="no-search-results" id="noSearchResults" role="status">
            <i class="fa-solid fa-magnifying-glass"></i>
            No tasks match your search.
        </div>
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const searchInput = document.getElementById('todoSearch');
            const taskCards = Array.from(document.querySelectorAll('.task-card'));
            const columns = Array.from(document.querySelectorAll('.task-column'));
            const noResults = document.getElementById('noSearchResults');

            if (!searchInput) return;

            searchInput.addEventListener('input', () => {
                const query = searchInput.value.trim().toLocaleLowerCase();
                let visibleTotal = 0;

                taskCards.forEach(card => {
                    const name = (card.dataset.taskName || card.textContent).toLocaleLowerCase();
                    const matches = name.includes(query);
                    card.hidden = !matches;
                    if (matches) visibleTotal++;
                });

                const visibleCounts = { todo: 0, waiting: 0, complete: 0 };

                columns.forEach(column => {
                    const visibleCards = column.querySelectorAll('.task-card:not([hidden])').length;
                    const count = column.querySelector('.column-count');
                    const emptyState = column.querySelector('.empty-column');
                    const status = column.dataset.column;

                    if (count) count.textContent = visibleCards;
                    if (visibleCounts[status] !== undefined) visibleCounts[status] = visibleCards;

                    // Hide the empty-state copy while a search is active.
                    if (emptyState) emptyState.hidden = query.length > 0;

                    // During a search, only keep columns with matching cards visible.
                    column.hidden = query.length > 0 && visibleCards === 0;
                });

                document.getElementById('todoSummaryCount').textContent = visibleCounts.todo;
                document.getElementById('waitingSummaryCount').textContent = visibleCounts.waiting;
                document.getElementById('completeSummaryCount').textContent = visibleCounts.complete;

                noResults.style.display = query.length > 0 && visibleTotal === 0 ? 'block' : 'none';
            });
        });
    </script>

    <%- include('nav bar/navbardown.ejs') %>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#f6f3eb">
    <title>Sign in | TT Timber Trader</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        :root {
            color-scheme: light;
            --ink: #24332b;
            --muted: #737e75;
            --green: #24553e;
            --green-dark: #183f2d;
            --green-soft: #e9f0e9;
            --amber: #e8a84b;
            --paper: #f6f3eb;
            --line: #e5e3d9;
            --white: #fffefa;
            --danger-bg: #fff1ef;
            --danger: #a13b32;
        }
        * { box-sizing: border-box; }
        html { min-height: 100%; -webkit-text-size-adjust: 100%; text-size-adjust: 100%; }
        body {
            margin: 0;
            min-height: 100vh;
            min-height: 100svh;
            display: grid;
            place-items: center;
            padding: 28px;
            background-color: var(--paper);
            background-image: radial-gradient(#d9d5c9 0.7px, transparent 0.7px);
            background-size: 18px 18px;
            color: var(--ink);
            font-family: "Segoe UI", system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
        }
        button, input { font: inherit; }
        .login-shell {
            width: min(100%, 980px);
            min-height: 590px;
            display: grid;
            grid-template-columns: 0.97fr 1.03fr;
            overflow: hidden;
            border: 1px solid #e4e0d4;
            border-radius: 22px;
            background: var(--white);
            box-shadow: 0 24px 70px rgba(47, 57, 43, .13), 0 3px 10px rgba(47, 57, 43, .04);
        }
        .welcome-panel {
            position: relative;
            isolation: isolate;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            min-width: 0;
            overflow: hidden;
            padding: 38px 42px 30px;
            background: var(--green);
            color: #fffdf6;
        }
        .welcome-panel::before {
            content: "";
            position: absolute;
            z-index: -1;
            width: 340px;
            height: 340px;
            right: -170px;
            bottom: -185px;
            border: 1px solid rgba(255,255,255,.12);
            border-radius: 50%;
            box-shadow: 0 0 0 34px rgba(255,255,255,.035), 0 0 0 70px rgba(255,255,255,.025);
        }
        .brand {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            width: fit-content;
            color: inherit;
            text-decoration: none;
        }
        .brand-mark {
            width: 46px;
            height: 46px;
            flex: 0 0 46px;
            display: grid;
            place-items: center;
            border-radius: 13px;
            border: 1px solid rgba(255,255,255,.42);
            background: #f0bd69;
            color: #263e2e;
            font-weight: 900;
            font-size: 19px;
            letter-spacing: -2px;
            box-shadow: inset 0 -3px 0 rgba(109, 71, 22, .13);
        }
        .brand-name { display: block; font-size: 16px; line-height: 1.25; font-weight: 800; letter-spacing: -.3px; }
        .brand-tagline { display: block; margin-top: 4px; color: #c9d9cb; font-size: 10px; font-weight: 700; letter-spacing: 1.6px; text-transform: uppercase; }
        .welcome-copy { max-width: 390px; margin: 44px 0 25px; }
        .little-label {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 7px 11px;
            border: 1px solid rgba(255,255,255,.18);
            border-radius: 999px;
            background: rgba(255,255,255,.08);
            color: #f4dfba;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: .4px;
        }
        .little-label i { color: #f0bd69; }
        .welcome-copy h1 {
            max-width: 360px;
            margin: 21px 0 15px;
            font-size: clamp(34px, 4vw, 46px);
            line-height: 1.08;
            letter-spacing: -1.7px;
            font-weight: 800;
        }
        .welcome-copy h1 span { color: #f2c577; }
        .welcome-copy p {
            max-width: 350px;
            margin: 0;
            color: #d5e0d5;
            font-size: 14px;
            line-height: 1.8;
        }
        .friendly-illustration {
            display: flex;
            align-items: center;
            gap: 16px;
            margin-top: 26px;
            padding: 13px 15px;
            border: 1px solid rgba(255,255,255,.14);
            border-radius: 15px;
            background: rgba(10, 35, 23, .19);
        }
        .timber-friend { flex: 0 0 82px; width: 82px; height: 70px; }
        .friendly-note { color: #fffdf6; font-size: 13px; line-height: 1.55; }
        .friendly-note strong { display: block; margin-bottom: 3px; color: #f4d69e; font-size: 14px; }
        .friendly-note span { color: #d5e0d5; }
        .welcome-footer { margin-top: 24px; color: #bed0c1; font-size: 11px; letter-spacing: .3px; }

        .form-panel { display: flex; align-items: center; justify-content: center; min-width: 0; padding: 52px clamp(28px, 5vw, 62px); }
        .login-card { width: 100%; max-width: 365px; }
        .mobile-brand { display: none; }
        .greeting { margin: 0 0 8px; color: var(--green); font-size: 13px; font-weight: 800; letter-spacing: .2px; }
        .greeting .wave { display: inline-block; margin-left: 2px; transform-origin: 70% 70%; animation: wave 2.3s ease-in-out 1; }
        @keyframes wave { 0%, 100% { transform: rotate(0); } 20%, 50%, 80% { transform: rotate(13deg); } 35%, 65% { transform: rotate(-7deg); } }
        .form-heading h2 { margin: 0; color: #26342b; font-size: 31px; line-height: 1.2; letter-spacing: -1.1px; font-weight: 800; }
        .form-heading p { margin: 11px 0 29px; color: var(--muted); font-size: 14px; line-height: 1.7; }
        .error-message {
            display: flex;
            align-items: flex-start;
            gap: 9px;
            margin: 0 0 20px;
            padding: 12px 13px;
            border: 1px solid #f0c2bd;
            border-radius: 11px;
            background: var(--danger-bg);
            color: var(--danger);
            font-size: 13px;
            line-height: 1.5;
        }
        .field { margin-bottom: 19px; }
        .field label { display: block; margin-bottom: 8px; color: #36473b; font-size: 12px; font-weight: 800; }
        .input-wrap { position: relative; }
        .input-icon { position: absolute; top: 50%; left: 15px; color: #829084; font-size: 14px; pointer-events: none; transform: translateY(-50%); }
        .field input {
            width: 100%;
            min-height: 52px;
            padding: 13px 45px 13px 42px;
            border: 1px solid #dcded4;
            border-radius: 11px;
            outline: none;
            background: #fbfaf6;
            color: #26342b;
            font-size: 16px;
            transition: border-color .18s ease, background .18s ease, box-shadow .18s ease;
        }
        .field input::placeholder { color: #9ca59a; }
        .field input:hover { border-color: #b8c5b5; }
        .field input:focus { border-color: #4e8965; background: #fff; box-shadow: 0 0 0 4px rgba(55, 119, 78, .11); }
        .password-toggle {
            position: absolute; top: 50%; right: 7px; display: grid; place-items: center;
            width: 38px; height: 38px; border: 0; border-radius: 9px;
            background: transparent; color: #78867b; cursor: pointer; transform: translateY(-50%);
        }
        .password-toggle:hover, .password-toggle:focus-visible { background: #edf1e9; color: var(--green); outline: none; }
        .form-note { display: flex; align-items: center; gap: 8px; margin: 2px 0 22px; color: #778277; font-size: 12px; }
        .form-note i { color: #4d8964; }
        .sign-in-btn {
            display: flex; align-items: center; justify-content: center; gap: 10px;
            width: 100%; min-height: 53px; padding: 14px 18px;
            border: 1px solid #204d36; border-radius: 11px;
            background: var(--green); color: white; font-size: 14px; font-weight: 800;
            cursor: pointer; box-shadow: 0 6px 0 #dfe7dc;
            transition: background .18s ease, transform .18s ease, box-shadow .18s ease;
        }
        .sign-in-btn:hover { background: var(--green-dark); transform: translateY(-1px); box-shadow: 0 8px 0 #dfe7dc; }
        .sign-in-btn:active { transform: translateY(1px); box-shadow: 0 3px 0 #dfe7dc; }
        .sign-in-btn:focus-visible { outline: 3px solid #b8d1b8; outline-offset: 3px; }
        .sign-in-btn:disabled { opacity: .8; cursor: wait; }
        .tiny-smile { display: flex; align-items: center; justify-content: center; gap: 7px; margin: 22px 0 0; color: #718074; font-size: 12px; }
        .tiny-smile i { color: #d89b3b; }
        .form-bottom { margin-top: 26px; padding-top: 18px; border-top: 1px solid #eeece4; color: #8a938a; font-size: 11px; line-height: 1.65; text-align: center; }
        .form-bottom strong { color: #667469; }
        [hidden] { display: none !important; }

        @media (max-width: 780px) {
            body { padding: 18px; }
            .login-shell { max-width: 470px; min-height: auto; grid-template-columns: 1fr; border-radius: 19px; }
            .welcome-panel { display: none; }
            .form-panel { padding: 30px clamp(21px, 6vw, 40px) 25px; }
            .mobile-brand { display: flex; align-items: center; gap: 11px; margin-bottom: 31px; }
            .mobile-brand .brand-mark { width: 43px; height: 43px; flex-basis: 43px; border-radius: 12px; }
            .form-heading h2 { font-size: clamp(27px, 6vw, 31px); }
            .form-heading p { margin-bottom: 25px; }
        }
        @media (max-width: 390px) {
            body { padding: max(9px, env(safe-area-inset-top)) max(9px, env(safe-area-inset-right)) max(9px, env(safe-area-inset-bottom)) max(9px, env(safe-area-inset-left)); }
            .form-panel { padding: 24px 17px 20px; }
            .mobile-brand { margin-bottom: 25px; }
            .brand-name { font-size: 15px; }
            .brand-tagline { font-size: 9px; letter-spacing: 1.2px; }
            .form-heading h2 { font-size: 27px; }
            .field { margin-bottom: 16px; }
            .form-note { margin-bottom: 18px; }
            .form-bottom { margin-top: 21px; }
        }
        @media (max-height: 620px) and (min-width: 781px) {
            body { padding-block: 12px; }
            .login-shell { min-height: 0; }
            .welcome-panel { padding-block: 27px; }
            .welcome-copy { margin-block: 25px; }
            .welcome-copy h1 { font-size: 38px; }
            .friendly-illustration { margin-top: 16px; }
            .form-panel { padding-block: 28px; }
            .form-heading p { margin-bottom: 20px; }
            .field { margin-bottom: 14px; }
        }
        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after { animation: none !important; scroll-behavior: auto !important; transition: none !important; }
        }
    </style>
</head>
<body>
    <main class="login-shell">
        <section class="welcome-panel" aria-label="TT Timber Trader welcome">
            <a class="brand" href="/login" aria-label="TT Timber Trader sign in">
                <span class="brand-mark" aria-hidden="true">TT</span>
                <span>
                    <span class="brand-name">TT Timber Trader</span>
                    <span class="brand-tagline">Your everyday work desk</span>
                </span>
            </a>

            <div class="welcome-copy">
                <span class="little-label"><i class="fa-solid fa-mug-hot" aria-hidden="true"></i> Take a breath. You’ve got this.</span>
                <h1>Let’s get today’s work <span>sorted.</span></h1>
                <p>Your purchases, payments, stock and to-dos, all in one place. Less hunting around, more getting things done.</p>

                <div class="friendly-illustration">
                    <svg class="timber-friend" viewBox="0 0 100 82" role="img" aria-label="A smiling little timber log">
                        <ellipse cx="49" cy="72" rx="35" ry="6" fill="#102f21" opacity=".25"/>
                        <g transform="rotate(-7 48 45)">
                            <rect x="9" y="25" width="70" height="34" rx="9" fill="#d99a4b" stroke="#f5d49b" stroke-width="2"/>
                            <ellipse cx="78" cy="42" rx="11" ry="17" fill="#efbb6c" stroke="#f5d49b" stroke-width="2"/>
                            <ellipse cx="78" cy="42" rx="6" ry="10" fill="none" stroke="#b97831" stroke-width="1.5"/>
                            <path d="M18 32 Q35 27 54 32" fill="none" stroke="#b97831" stroke-width="2" opacity=".65"/>
                            <path d="M19 51 Q39 56 59 50" fill="none" stroke="#b97831" stroke-width="2" opacity=".65"/>
                            <circle cx="31" cy="40" r="2.5" fill="#3d3429"/>
                            <circle cx="46" cy="39" r="2.5" fill="#3d3429"/>
                            <path d="M31 46 Q38 54 46 45" fill="none" stroke="#3d3429" stroke-width="2.5" stroke-linecap="round"/>
                            <circle cx="25" cy="45" r="3" fill="#e98567" opacity=".85"/>
                            <circle cx="52" cy="44" r="3" fill="#e98567" opacity=".85"/>
                        </g>
                        <path d="M30 22 C20 13 23 5 33 8 C39 9 39 17 35 22" fill="#78a76f" stroke="#c4dfac" stroke-width="1.5"/>
                        <path d="M35 22 C38 10 48 8 49 16 C49 21 42 24 35 22" fill="#9fca85" stroke="#c4dfac" stroke-width="1.5"/>
                    </svg>
                    <div class="friendly-note">
                        <strong>Good to see you! 👋</strong>
                        <span>Tea first, task list next. Either way, you’re in the right place.</span>
                    </div>
                </div>
            </div>

            <div class="welcome-footer">Made for the everyday hustle at TT Timber Trader.</div>
        </section>

        <section class="form-panel" aria-labelledby="loginTitle">
            <div class="login-card">
                <div class="mobile-brand" aria-label="TT Timber Trader">
                    <span class="brand-mark" aria-hidden="true">TT</span>
                    <span>
                        <span class="brand-name">TT Timber Trader</span>
                        <span class="brand-tagline">Your everyday work desk</span>
                    </span>
                </div>

                <header class="form-heading">
                    <p class="greeting">Hey, welcome back <span class="wave" aria-hidden="true">👋</span></p>
                    <h2 id="loginTitle">Let’s get you in.</h2>
                    <p>Your workbench is waiting. Sign in with your usual account to pick up where you left off.</p>
                </header>

                <% if (typeof error !== 'undefined' && error) { %>
                    <div class="error-message" role="alert">
                        <i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i>
                        <span><%= error %></span>
                    </div>
                <% } %>

                <form action="/login" method="POST" id="loginForm" autocomplete="on">
                    <div class="field">
                        <label for="username">Username</label>
                        <div class="input-wrap">
                            <i class="fa-regular fa-user input-icon" aria-hidden="true"></i>
                            <input id="username" type="text" name="username" placeholder="Your username" autocomplete="username" autocapitalize="none" spellcheck="false" required autocorrect="off" enterkeyhint="next">
                        </div>
                    </div>

                    <div class="field">
                        <label for="password">Password</label>
                        <div class="input-wrap">
                            <i class="fa-solid fa-lock input-icon" aria-hidden="true"></i>
                            <input id="password" type="password" name="password" placeholder="Your password" autocomplete="current-password" enterkeyhint="go" required>
                            <button type="button" class="password-toggle" id="togglePassword" aria-label="Show password" aria-pressed="false" title="Show password">
                                <i class="fa-regular fa-eye" aria-hidden="true"></i>
                            </button>
                        </div>
                    </div>

                    <p class="form-note"><i class="fa-solid fa-leaf" aria-hidden="true"></i> Just your regular account. No new setup needed.</p>

                    <button type="submit" class="sign-in-btn" id="signInButton">
                        <span>Let’s go</span>
                        <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                    </button>
                </form>

                <p class="tiny-smile"><i class="fa-regular fa-face-smile" aria-hidden="true"></i> One thing at a time. You’ve got this.</p>
                <div class="form-bottom">Trouble signing in? <strong>Contact your system administrator.</strong></div>
            </div>
        </section>
    </main>

    <script>
        (() => {
            const passwordInput = document.getElementById('password');
            const togglePassword = document.getElementById('togglePassword');
            const loginForm = document.getElementById('loginForm');
            const signInButton = document.getElementById('signInButton');

            if (passwordInput && togglePassword) {
                togglePassword.addEventListener('click', () => {
                    const reveal = passwordInput.type === 'password';
                    passwordInput.type = reveal ? 'text' : 'password';
                    togglePassword.setAttribute('aria-pressed', String(reveal));
                    togglePassword.setAttribute('aria-label', reveal ? 'Hide password' : 'Show password');
                    togglePassword.title = reveal ? 'Hide password' : 'Show password';
                    togglePassword.innerHTML = reveal
                        ? '<i class="fa-regular fa-eye-slash" aria-hidden="true"></i>'
                        : '<i class="fa-regular fa-eye" aria-hidden="true"></i>';
                });
            }

            if (loginForm && signInButton) {
                loginForm.addEventListener('submit', () => {
                    if (!loginForm.checkValidity()) return;
                    signInButton.disabled = true;
                    signInButton.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin" aria-hidden="true"></i><span>Just a moment...</span>';
                });
            }
        })();
    </script>
</body>
</html>

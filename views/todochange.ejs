<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Tasks | TT Timber Trader</title>
    <link rel="stylesheet" href="/stylesheets/receipt.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer">
    <style>
        :root {
            --tt-primary: #285ee8;
            --tt-primary-dark: #1748c7;
            --tt-text: #17243b;
            --tt-muted: #68768d;
            --tt-border: #e2e8f0;
            --tt-bg: #f4f7fc;
            --tt-green: #079669;
            --tt-amber: #d97706;
            --tt-shadow: 0 16px 40px rgba(23, 36, 59, .08);
        }
        * { box-sizing: border-box; }
        body { margin: 0; background: var(--tt-bg); color: var(--tt-text); font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
        .todo-change-page { position: relative; z-index: 1; width: min(1040px, calc(100% - 130px)); margin: 0 28px 0 100px; padding: 112px 0 42px; }
        .page-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 20px; margin-bottom: 24px; }
        .eyebrow { color: var(--tt-primary); font-size: 11px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; margin: 0 0 7px; }
        .page-title { font-size: clamp(26px, 3vw, 34px); line-height: 1.15; font-weight: 800; letter-spacing: -.035em; margin: 0; }
        .page-subtitle { color: var(--tt-muted); font-size: 14px; margin: 9px 0 0; }
        .back-link { display: inline-flex; align-items: center; gap: 9px; padding: 11px 15px; border: 1px solid var(--tt-border); background: white; color: #31405a; text-decoration: none; border-radius: 12px; font-weight: 700; font-size: 13px; white-space: nowrap; box-shadow: 0 3px 12px rgba(23,36,59,.03); }
        .back-link:hover { border-color: #c5d4ff; background: #f9fbff; color: var(--tt-primary); }
        .task-form { display: grid; gap: 20px; }
        .panel { background: white; border: 1px solid var(--tt-border); border-radius: 18px; box-shadow: var(--tt-shadow); overflow: hidden; }
        .panel-heading { padding: 20px 24px; border-bottom: 1px solid var(--tt-border); display: flex; align-items: center; gap: 13px; }
        .panel-icon { width: 42px; height: 42px; display: grid; place-items: center; border-radius: 13px; background: #eaf0ff; color: var(--tt-primary); font-size: 17px; flex: 0 0 auto; }
        .panel-heading h2 { font-size: 17px; margin: 0; font-weight: 800; }
        .panel-heading p { color: var(--tt-muted); font-size: 12px; margin: 4px 0 0; }
        .panel-body { padding: 24px; }
        .field-label { display: block; color: #34435a; font-size: 12px; font-weight: 800; margin-bottom: 8px; }
        .text-field, .status-select { width: 100%; min-width: 0; border: 1px solid #d9e1ee; border-radius: 11px; background: #fff; padding: 13px 14px; color: var(--tt-text); font: inherit; font-size: 14px; outline: none; transition: border-color .18s, box-shadow .18s; }
        .text-field:focus, .status-select:focus { border-color: #82a5ff; box-shadow: 0 0 0 4px rgba(40,94,232,.10); }
        .current-task-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 20px; }
        .status-label { color: #34435a; font-size: 12px; font-weight: 800; display: block; margin-bottom: 10px; }
        .status-options { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
        .status-option { position: relative; }
        .status-option input { position: absolute; opacity: 0; inset: 0; pointer-events: none; }
        .status-option label { display: flex; align-items: center; justify-content: center; gap: 8px; padding: 13px 12px; border: 1px solid var(--tt-border); border-radius: 11px; background: #fff; color: #64748b; cursor: pointer; font-size: 13px; font-weight: 800; transition: all .18s; }
        .status-option.todo label i { color: #64748b; }
        .status-option.waiting label i { color: var(--tt-amber); }
        .status-option.complete label i { color: var(--tt-green); }
        .status-option input:checked + label { border-color: var(--tt-primary); background: #f0f5ff; color: var(--tt-primary-dark); box-shadow: 0 0 0 3px rgba(40,94,232,.08); }
        .bulk-heading { display: flex; align-items: center; justify-content: space-between; gap: 14px; width: 100%; }
        .add-row-btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; border: 1px solid #cddaff; border-radius: 10px; background: #f2f6ff; color: var(--tt-primary-dark); padding: 10px 13px; font: inherit; font-size: 12px; font-weight: 800; cursor: pointer; white-space: nowrap; }
        .add-row-btn:hover { background: #e5edff; }
        .bulk-intro { color: var(--tt-muted); font-size: 13px; line-height: 1.5; margin: 0 0 17px; }
        .bulk-table-header, .new-task-row { display: grid; grid-template-columns: minmax(0, 1fr) 210px 44px; gap: 10px; align-items: center; }
        .bulk-table-header { padding: 0 0 8px; color: #718096; text-transform: uppercase; font-size: 10px; font-weight: 800; letter-spacing: .08em; }
        .new-task-row { margin-bottom: 10px; }
        .new-task-row:last-child { margin-bottom: 0; }
        .new-task-row .text-field, .new-task-row .status-select { padding: 11px 12px; font-size: 13px; }
        .remove-row-btn { height: 42px; width: 44px; display: grid; place-items: center; border: 1px solid #f2caca; background: #fff7f7; color: #c24141; border-radius: 10px; cursor: pointer; }
        .remove-row-btn:hover { background: #feeaea; }
        .form-footer { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; padding-top: 2px; }
        .form-note { color: var(--tt-muted); font-size: 12px; margin: 0; }
        .footer-actions { display: flex; justify-content: flex-end; gap: 10px; }
        .cancel-btn, .save-btn { display: inline-flex; align-items: center; justify-content: center; gap: 9px; min-height: 44px; padding: 12px 17px; border-radius: 11px; font: inherit; font-size: 13px; font-weight: 800; text-decoration: none; cursor: pointer; }
        .cancel-btn { border: 1px solid var(--tt-border); background: white; color: #46546b; }
        .save-btn { border: 1px solid var(--tt-primary); background: var(--tt-primary); color: white; box-shadow: 0 7px 16px rgba(40,94,232,.18); }
        .save-btn:hover { background: var(--tt-primary-dark); }
        .cancel-btn:hover { background: #f8fafc; }
        @media (min-width: 760px) { .current-task-grid { grid-template-columns: minmax(0, 1fr); } }
        @media (max-width: 760px) {
            .todo-change-page { width: auto; margin: 0 14px 0 82px; padding-top: 96px; }
            .page-header { flex-direction: column; align-items: stretch; }
            .back-link { align-self: flex-start; }
            .panel-heading, .panel-body { padding: 18px; }
            .bulk-table-header, .new-task-row { grid-template-columns: minmax(0, 1fr) 150px 40px; gap: 7px; }
            .remove-row-btn { width: 40px; }
        }
        @media (max-width: 520px) {
            .todo-change-page { margin: 0 10px 0 72px; padding-top: 88px; }
            .bulk-table-header { display: none; }
            .new-task-row { grid-template-columns: minmax(0, 1fr) 40px; gap: 8px; padding: 12px; border: 1px solid var(--tt-border); border-radius: 12px; margin-bottom: 12px; }
            .new-task-row .new-task-name { grid-column: 1 / 2; }
            .new-task-row .status-select { grid-column: 1 / 2; }
            .new-task-row .remove-row-btn { grid-column: 2 / 3; grid-row: 1 / 3; height: 100%; }
            .status-options { grid-template-columns: 1fr; }
            .status-option label { justify-content: flex-start; }
            .bulk-heading { align-items: flex-start; flex-direction: column; }
            .add-row-btn { width: 100%; }
            .form-footer { align-items: stretch; }
            .footer-actions { width: 100%; }
            .footer-actions > * { flex: 1; }
        }
    </style>
</head>
<body>
    <%- include('nav bar/navbar.ejs') %>

    <main class="todo-change-page">
        <header class="page-header">
            <div>
                <p class="eyebrow">TT Timber Trader · Work Planner</p>
                <h1 class="page-title">Manage Tasks</h1>
                <p class="page-subtitle">Update this task and add more tasks in the same submission.</p>
            </div>
            <a href="/todo" class="back-link"><i class="fa-solid fa-arrow-left"></i> Back to Task Board</a>
        </header>

        <form class="task-form" action="/updatetodo/<%= generalEdit._id %>" method="POST" id="taskForm">
            <section class="panel">
                <div class="panel-heading">
                    <div class="panel-icon"><i class="fa-solid fa-pen-to-square"></i></div>
                    <div>
                        <h2>Edit Existing Task</h2>
                        <p>Changes will apply to the task you opened.</p>
                    </div>
                </div>
                <div class="panel-body">
                    <div class="current-task-grid">
                        <div>
                            <label class="field-label" for="todoactual">Task name</label>
                            <input class="text-field" id="todoactual" type="text" name="todoactual" value="<%= generalEdit.name || '' %>" placeholder="What needs to be done?" required maxlength="250">
                        </div>
                        <div>
                            <span class="status-label">Current status</span>
                            <div class="status-options">
                                <div class="status-option todo">
                                    <input type="radio" name="toggle" value="1" id="current-todo" <%= Number(generalEdit.work) === 1 ? 'checked' : '' %> required>
                                    <label for="current-todo"><i class="fa-regular fa-circle"></i> TODO</label>
                                </div>
                                <div class="status-option waiting">
                                    <input type="radio" name="toggle" value="2" id="current-waiting" <%= Number(generalEdit.work) === 2 ? 'checked' : '' %>>
                                    <label for="current-waiting"><i class="fa-regular fa-clock"></i> WAITING</label>
                                </div>
                                <div class="status-option complete">
                                    <input type="radio" name="toggle" value="3" id="current-complete" <%= Number(generalEdit.work) === 3 ? 'checked' : '' %>>
                                    <label for="current-complete"><i class="fa-solid fa-check"></i> COMPLETE</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <section class="panel">
                <div class="panel-heading">
                    <div class="panel-icon"><i class="fa-solid fa-list-check"></i></div>
                    <div class="bulk-heading">
                        <div>
                            <h2>Add Multiple Tasks</h2>
                            <p>Enter several tasks below and save them all together.</p>
                        </div>
                        <button type="button" class="add-row-btn" id="addTaskRowBtn">
                            <i class="fa-solid fa-plus"></i> Add another task
                        </button>
                    </div>
                </div>
                <div class="panel-body">
                    <p class="bulk-intro">New rows are optional. Leave a row blank and it will be ignored. Each new task can have its own status.</p>
                    <div class="bulk-table-header" aria-hidden="true">
                        <span>New task name</span>
                        <span>Status</span>
                        <span></span>
                    </div>
                    <div id="newTaskRows">
                        <div class="new-task-row">
                            <input class="text-field new-task-name" type="text" name="newTodoName[]" maxlength="250" placeholder="Enter a new task">
                            <select class="status-select" name="newTodoWork[]" aria-label="Status for new task">
                                <option value="1" selected>TODO</option>
                                <option value="2">WAITING</option>
                                <option value="3">COMPLETE</option>
                            </select>
                            <button class="remove-row-btn" type="button" title="Remove this row" aria-label="Remove this row"><i class="fa-solid fa-xmark"></i></button>
                        </div>
                    </div>
                </div>
            </section>

            <footer class="form-footer">
                <p class="form-note"><i class="fa-solid fa-circle-info"></i> Existing task edits and non-empty new tasks save together.</p>
                <div class="footer-actions">
                    <a href="/todo" class="cancel-btn">Cancel</a>
                    <button type="submit" class="save-btn"><i class="fa-solid fa-floppy-disk"></i> Save Changes & Tasks</button>
                </div>
            </footer>
        </form>
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const rowsContainer = document.getElementById('newTaskRows');
            const addButton = document.getElementById('addTaskRowBtn');

            function addTaskRow(focusInput = true) {
                const row = document.createElement('div');
                row.className = 'new-task-row';
                row.innerHTML = `
                    <input class="text-field new-task-name" type="text" name="newTodoName[]" maxlength="250" placeholder="Enter a new task">
                    <select class="status-select" name="newTodoWork[]" aria-label="Status for new task">
                        <option value="1" selected>TODO</option>
                        <option value="2">WAITING</option>
                        <option value="3">COMPLETE</option>
                    </select>
                    <button class="remove-row-btn" type="button" title="Remove this row" aria-label="Remove this row"><i class="fa-solid fa-xmark"></i></button>
                `;
                rowsContainer.appendChild(row);
                if (focusInput) row.querySelector('.new-task-name').focus();
            }

            addButton.addEventListener('click', () => addTaskRow(true));

            rowsContainer.addEventListener('click', event => {
                const removeButton = event.target.closest('.remove-row-btn');
                if (!removeButton) return;

                const rows = rowsContainer.querySelectorAll('.new-task-row');
                const row = removeButton.closest('.new-task-row');

                if (rows.length === 1) {
                    row.querySelector('.new-task-name').value = '';
                    row.querySelector('.status-select').value = '1';
                } else {
                    row.remove();
                }
            });
        });
    </script>

    <%- include('nav bar/navbardown.ejs') %>
</body>
</html>
